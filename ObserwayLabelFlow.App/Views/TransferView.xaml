<UserControl x:Class="ObserwayLabelFlow.App.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:ObserwayLabelFlow.App.Infrastructure"
             xmlns:controls="clr-namespace:ObserwayLabelFlow.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="960"
             Background="{StaticResource Bg0Brush}">
    <Grid Margin="12,2,12,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WorkspaceModeBanner}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ModeSelectIconHost}"
                        Width="52"
                        Height="52"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7EC;"
                               Style="{StaticResource ModeSelectIconGlyph}"
                               FontSize="22" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_ModeSelect_ProductOutboundTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text0Brush}"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{DynamicResource Loc_ModeSelect_ProductOutboundDesc}"
                               FontSize="13"
                               Foreground="{StaticResource Text1Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardSurface}" Padding="28,32" Margin="0,8,0,0">
            <Grid ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="640">
                    <Border Width="72"
                            Height="72"
                            CornerRadius="18"
                            HorizontalAlignment="Center"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE7EC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Margin="0,20,0,0"
                               Text="{DynamicResource Loc_Transfer_ScanTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text0Brush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <TextBlock Margin="0,8,0,0"
                               Text="{DynamicResource Loc_Transfer_Hint}"
                               FontSize="14"
                               Foreground="{StaticResource Text1Brush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="480" />

                    <StackPanel Margin="0,28,0,0" MaxWidth="520" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource FilterFieldLabel}"
                                   HorizontalAlignment="Left"
                                   infra:FieldLabelAssist.LocKey="Transfer_VehicleLabel" />
                        <Grid>
                            <TextBox Style="{StaticResource TextBoxModern}"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,10"
                                     Text="{Binding TransferVehicleName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock IsHitTestVisible="False"
                                       Margin="16,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource Text1Brush}"
                                       Opacity="0.55"
                                       Text="{DynamicResource Loc_Transfer_VehiclePlaceholder}"
                                       Visibility="{Binding TransferVehicleName, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource FilterFieldLabel}"
                                   HorizontalAlignment="Left"
                                   infra:FieldLabelAssist.LocKey="Transfer_QueryLabel" />
                        <Grid>
                            <TextBox x:Name="TransferQueryBox"
                                     Style="{StaticResource TextBoxModern}"
                                     Height="52"
                                     FontSize="16"
                                     Padding="14,12"
                                     Text="{Binding TransferQuery, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="TransferQueryBox_TextChanged"
                                     PreviewKeyDown="TransferQueryBox_PreviewKeyDown" />
                            <TextBlock IsHitTestVisible="False"
                                       Margin="16,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource Text1Brush}"
                                       Opacity="0.55"
                                       Text="{DynamicResource Loc_Transfer_QueryPlaceholder}"
                                       Visibility="{Binding TransferQuery, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonGhost}"
                                Height="48"
                                MinWidth="120"
                                Padding="16,10"
                                FontSize="14"
                                Content="{DynamicResource Loc_Transfer_Lookup}"
                                Command="{Binding LookupTransferCommand}" />
                        <Button Margin="12,0,0,0"
                                Style="{StaticResource ButtonPrimary}"
                                Height="48"
                                MinWidth="150"
                                Padding="18,10"
                                FontSize="15"
                                Content="{DynamicResource Loc_Transfer_Load}"
                                Command="{Binding LoadToVehicleCommand}" />
                        <Button Margin="12,0,0,0"
                                Style="{StaticResource ButtonGhost}"
                                Height="48"
                                MinWidth="110"
                                Padding="16,10"
                                FontSize="14"
                                Content="{DynamicResource Loc_OperationClear}"
                                Command="{Binding ClearTransferCommand}" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text0Brush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="520"
                               Text="{Binding TransferOrderStatusDisplay}"
                               Visibility="{Binding TransferOrderStatusDisplay, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />

                    <Border Margin="0,16,0,0"
                            Padding="16,14"
                            CornerRadius="{StaticResource R12}"
                            Background="#2A1A12"
                            BorderBrush="#E8A87C"
                            BorderThickness="1"
                            MaxWidth="520"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding IsTransferBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#E8A87C"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="{Binding TransferBlockReason}" />
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="16,14"
                            CornerRadius="{StaticResource R12}"
                            Background="#1A2A22"
                            BorderBrush="{StaticResource ToastSuccessBrush}"
                            BorderThickness="1"
                            MaxWidth="520"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding IsTransferSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource ToastSuccessBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ToastSuccessBrush}"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource Loc_Transfer_LoadedBanner}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="13"
                               Foreground="{StaticResource Text1Brush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="520"
                               Text="{Binding TransferStatusMessage}"
                               Visibility="{Binding TransferStatusMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Background="#B30B1220"
                        Panel.ZIndex="200"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:LoadingSpinner Width="44"
                                                 Height="44"
                                                 SpinnerBrush="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="{DynamicResource Loc_QueryingLabel}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text0Brush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
