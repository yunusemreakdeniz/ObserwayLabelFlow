<UserControl x:Class="ObserwayLabelFlow.App.Views.ModeSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="960"
             Background="{StaticResource Bg0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="980"
                    Margin="40,24">
            <TextBlock Text="{DynamicResource Loc_ModeSelect_Title}"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text0Brush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Margin="0,10,0,8"
                       Text="{DynamicResource Loc_ModeSelect_Subtitle}"
                       FontSize="15"
                       Foreground="{StaticResource Text1Brush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Margin="0,0,0,28"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding SelectedWarehouseDisplayName}"
                       Visibility="{Binding SelectedWarehouseDisplayName, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource ModeSelectCardButton}"
                        Margin="0,0,8,0"
                        Width="260"
                        Visibility="{Binding CanSelectInbound, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding SelectProductInboundCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource ModeSelectIconHost}">
                            <TextBlock Text="&#xE8F1;"
                                       Style="{StaticResource ModeSelectIconGlyph}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0"
                                   Text="{DynamicResource Loc_ModeSelect_ProductInboundTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text0Brush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{DynamicResource Loc_ModeSelect_ProductInboundDesc}"
                                   FontSize="13"
                                   Foreground="{StaticResource Text1Brush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="220" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModeSelectCardButton}"
                        Margin="8,0,0,0"
                        Width="260"
                        Visibility="{Binding CanSelectOutbound, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding SelectProductOutboundCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource ModeSelectIconHost}">
                            <TextBlock Text="&#xE898;"
                                       Style="{StaticResource ModeSelectIconGlyph}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0"
                                   Text="{DynamicResource Loc_ModeSelect_ProductOutboundTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text0Brush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{DynamicResource Loc_ModeSelect_ProductOutboundDesc}"
                                   FontSize="13"
                                   Foreground="{StaticResource Text1Brush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="220" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Margin="0,32,0,0"
                    Style="{StaticResource ButtonGhost}"
                    Height="44"
                    MinWidth="180"
                    HorizontalAlignment="Center"
                    Content="{DynamicResource Loc_ChangeWarehouse}"
                    Command="{Binding ChangeWarehouseCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
